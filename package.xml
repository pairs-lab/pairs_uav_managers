<?xml version="1.0"?>
<package format="2">

  <name>pairs_uav_managers</name>
  <version>1.0.4</version>
  <description>The pairs_uav_managers package</description>

  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>
