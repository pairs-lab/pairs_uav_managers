<?xml version="1.0"?>
<package format="2">

  <name>pairs_uav_managers</name>
  <version>1.0.0</version>
  <description>PAIRS UAV manager suite — ControlManager, UavManager, EstimationManager, TransformManager, GainManager, ConstraintManager</description>

  <maintainer email="alex@dsc-labs.io">PAIRS Team</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cmake_modules</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>nodelet</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pairs_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pairs_lib</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rostest</depend>
  <depend>pairs_uav_testing</depend>

  <export>
    <nodelet plugin="${prefix}/nodelets.xml" />
    <pairs_uav_managers plugin="${prefix}/plugins.xml" />
  </export>

</package>
